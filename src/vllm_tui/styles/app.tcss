#monitor-note, #models-note, #search-note {
    height: auto;
    color: $text-muted;
    padding: 0 1;
}

#confirm-box, #download-box {
    width: 70;
    height: auto;
    border: round $accent;
    background: $panel;
    padding: 1 2;
    align: center middle;
}

#detail-box {
    width: 90%;
    height: 80%;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}

#detail-table {
    height: 1fr;
}

#confirm-hint {
    color: $text-muted;
    padding: 1 0 0 0;
}

#serve-plan-box {
    width: 76;
    height: auto;
    border: round $accent;
    background: $panel;
    padding: 1 2;
    align: center middle;
}

#serve-plan-title {
    text-style: bold;
}

.serve-plan-ok { color: green; }
.serve-plan-warn { color: yellow; }
.serve-plan-fail { color: red; }
.serve-plan-info { color: $text-muted; }

#serve-plan-gap {
    height: 1;
}

#serve-plan-command {
    text-style: bold;
    background: $surface;
}

#serve-plan-hint {
    color: $text-muted;
    padding: 1 0 0 0;
}

ConfirmDialog, ModelDetailScreen, DownloadProgressScreen, ServePlanScreen {
    align: center middle;
}
